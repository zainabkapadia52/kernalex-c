# Edge case parser tests (valid syntax)

struct Point {
    int x;
    int y;
};

int sum(int a, int b) {
    return a + b;
}

int main() {
    int i = 0;
    int arr[3];
    int* p = &arr[0];
    int value = *p;

    struct Point pt;
    pt.x = 1;
    pt.y = 2;

    switch (i) {
        case 0:
            i = 1;
            break;
        default:
            i = 2;
    }

    for (int j = 0; j < 3; j++) {
        arr[j] = j;
    }

    while (i < 10) {
        i++;
    }

    repeat {
        i--;
    } until (i == 0);

    if (i == 0) {
        i = 1;
    } else {
        i = 2;
    }

    return 0;
}
