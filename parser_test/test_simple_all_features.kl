# Simple Comprehensive Lexer Validation
# This test exercises ALL lexer features in valid parser-friendly syntax

int main() {
    # All type keywords
    int x = 10;
    short y = 20;
    float z = 3.14;
    char c = 'a';
    bool b = true;
    
    # Numeric formats
    int dec = 42;
    int bin = 0b1010;
    int oct = 0o777;
    int hex = 0xDEAD;
    float f1 = 1.5;
    float f2 = .5;
    float f3 = 5.;
    float f4 = 1.5e10;
    float f5 = 3.14e-2;
    float f6 = .5E+3;
    
    # Literals with escape sequences
    char c1 = 'a';
    char c2 = '\n';
    char c3 = '\t';
    char c4 = '\\';
    char c5 = '\'';
    char c6 = '\"';
    char c7 = '\0';
    
    # Operators (assignment forms)
    x = 100;
    x += 5;
    x -= 3;
    x ^= 2;
    x /= 2;
    x %= 7;
    
    # Operators (increment/decrement)
    x++;
    x--;
    
    # Control flow keywords
    if (x > 0) {
        x = 1;
    } else {
        x = 0;
    }
    
    while (y < 100) {
        y++;
    }
    
    for (int i = 0; i < 10; i++) {
        continue;
    }
    
    switch (x) {
        case 1:
            break;
        default:
            continue;
    }
    
    repeat {
        y--;
    } until (y == 0);
    
    # begin/end blocks
    begin
        int local = sizeof(int);
        return local;
    end
}

# Signed/unsigned keywords 
unsigned int test1() {
    return 0;
}

signed int test2() {
    return 0;
}

# extern/static keywords
extern int ext_var;
static int stat_var;

# struct keyword
struct Point {
    int x;
    int y;
};
