# Lexer Validation Test 2: All Operators
# If this parses successfully, all operators are tokenized correctly

int main() {
    int x = 10;
    int y = 20;
    int z = 0;
    int* p;
    
    # Arithmetic operators: + - * / %
    z = x + y;
    z = x - y;
    z = x * y;
    z = x / y;
    z = x % y;
    
    # Assignment operators: = += -= *= /= %= ^=
    z = 5;
    z += 1;
    z -= 1;
    z *= 2;
    z /= 2;
    z %= 3;
    z ^= 1;
    
    # Increment/Decrement: ++ --
    x++;
    x--;
    ++y;
    --y;
    
    # Comparison operators: == != < <= > >= <=>
    if (x == y) { z = 1; }
    if (x != y) { z = 2; }
    if (x < y) { z = 3; }
    if (x <= y) { z = 4; }
    if (x > y) { z = 5; }
    if (x >= y) { z = 6; }
    z = x <=> y;
    
    # Logical operators: && || !
    if (x > 0 && y > 0) { z = 1; }
    if (x > 0 || y > 0) { z = 2; }
    if (!x) { z = 3; }
    
    # Bitwise operators: & | ^ ~ << >> ^^
    z = x & y;
    z = x | y;
    z = x ^ y;
    z = ~x;
    z = x << 2;
    z = x >> 2;
    z = x ^^ y;
    
    # Pointer operators: & * ->
    p = &x;
    z = *p;
    
    struct Point {
        int x;
        int y;
    };
    
    struct Point pt;
    struct Point* ppt = &pt;
    z = ppt->x;
    
    return 0;
}
