# Parser/Lexer Validation: All Numeric Literal Formats

int main() begin
    # Decimal integers
    int d1 = 0;
    int d2 = 1;
    int d3 = 42;
    int d4 = 123456789;
    
    # Binary integers (0b prefix)
    int b1 = 0b0;
    int b2 = 0b1;
    int b3 = 0b1010;
    int b4 = 0b11111111;
    int b5 = 0b10101010;
    
    # Octal integers (0o prefix)
    int o1 = 0o0;
    int o2 = 0o7;
    int o3 = 0o10;
    int o4 = 0o777;
    int o5 = 0o1234567;
    
    # Hexadecimal integers (0x prefix)
    int h1 = 0x0;
    int h2 = 0xa;
    int h3 = 0xF;
    int h4 = 0x10;
    int h5 = 0xFF;
    int h6 = 0xDEAD;
    int h7 = 0xBEEF;
    int h8 = 0xCAFE;
    int h9 = 0xdeadbeef;
    
    # Floating-point: standard format
    float f1 = 0.0;
    float f2 = 1.0;
    float f3 = 3.14;
    float f4 = 0.123;
    float f5 = 123.456;
    
    # Floating-point: no leading digits
    float f6 = .1;
    float f7 = .5;
    float f8 = .999;
    
    # Floating-point: no trailing digits
    float f9 = 1.;
    float f10 = 10.;
    float f11 = 999.;
    
    # Scientific notation: positive exponent
    float s1 = 1.0e1;
    float s2 = 1.0e10;
    float s3 = 1.5e5;
    float s4 = 3.14e2;
    
    # Scientific notation: negative exponent
    float s5 = 1.0e-1;
    float s6 = 1.0e-10;
    float s7 = 1.5e-5;
    float s8 = 3.14e-2;
    float s9 = 6.022e-23;
    
    # Scientific notation: explicit + sign
    float s10 = 1.0e+1;
    float s11 = 1.0e+10;
    float s12 = 1.5e+5;
    
    # Scientific notation: uppercase E
    float s13 = 1.0E10;
    float s14 = 3.14E-2;
    float s15 = .5E+3;
    
    # Edge cases
    float e1 = 1.23e-100;
    float e2 = 9.87e+100;
    float e3 = 6.626e-34;
    
    return 0;
end
