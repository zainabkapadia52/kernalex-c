Terminals unused in grammar

    TOK_SIZEOF


Grammar

    0 $accept: translation_unit $end

    1 primary_expression: TOK_IDENTIFIER
    2                   | constant
    3                   | string
    4                   | TOK_TRUE
    5                   | TOK_FALSE
    6                   | TOK_LPAREN expression TOK_RPAREN

    7 constant: TOK_INTEGER
    8         | TOK_FLOAT_LIT
    9         | TOK_CHAR_LIT

   10 string: TOK_STRING_LIT

   11 postfix_expression: primary_expression
   12                   | postfix_expression TOK_LBRACKET expression TOK_RBRACKET
   13                   | postfix_expression TOK_LPAREN TOK_RPAREN
   14                   | postfix_expression TOK_LPAREN argument_expression_list TOK_RPAREN
   15                   | postfix_expression TOK_DOT TOK_IDENTIFIER
   16                   | postfix_expression TOK_ARROW TOK_IDENTIFIER
   17                   | postfix_expression TOK_INC
   18                   | postfix_expression TOK_DEC
   19                   | TOK_LPAREN type_name TOK_RPAREN TOK_BEGIN initializer_list TOK_END
   20                   | TOK_LPAREN type_name TOK_RPAREN TOK_BEGIN initializer_list TOK_COMMA TOK_END

   21 argument_expression_list: assignment_expression
   22                         | argument_expression_list TOK_COMMA assignment_expression

   23 unary_expression: postfix_expression
   24                 | TOK_INC unary_expression
   25                 | TOK_DEC unary_expression
   26                 | TOK_MINUS cast_expression
   27                 | TOK_PLUS cast_expression
   28                 | TOK_NOT cast_expression
   29                 | TOK_BITNOT cast_expression
   30                 | TOK_AMP cast_expression
   31                 | TOK_STAR cast_expression

   32 cast_expression: unary_expression
   33                | TOK_LPAREN type_name TOK_RPAREN cast_expression

   34 multiplicative_expression: cast_expression
   35                          | multiplicative_expression TOK_MULT cast_expression
   36                          | multiplicative_expression TOK_DIV cast_expression
   37                          | multiplicative_expression TOK_MOD cast_expression

   38 additive_expression: multiplicative_expression
   39                    | additive_expression TOK_PLUS multiplicative_expression
   40                    | additive_expression TOK_MINUS multiplicative_expression

   41 shift_expression: additive_expression
   42                 | shift_expression TOK_LSHIFT additive_expression
   43                 | shift_expression TOK_RSHIFT additive_expression

   44 relational_expression: shift_expression
   45                      | relational_expression TOK_LT shift_expression
   46                      | relational_expression TOK_GT shift_expression
   47                      | relational_expression TOK_LE shift_expression
   48                      | relational_expression TOK_GE shift_expression
   49                      | relational_expression TOK_SPACESHIP shift_expression

   50 equality_expression: relational_expression
   51                    | equality_expression TOK_EQ relational_expression
   52                    | equality_expression TOK_NE relational_expression

   53 and_expression: equality_expression
   54               | and_expression TOK_AMP equality_expression

   55 exclusive_or_expression: and_expression
   56                        | exclusive_or_expression TOK_XOR and_expression

   57 inclusive_or_expression: exclusive_or_expression
   58                        | inclusive_or_expression TOK_BITOR exclusive_or_expression

   59 logical_and_expression: inclusive_or_expression
   60                       | logical_and_expression TOK_AND inclusive_or_expression

   61 logical_or_expression: logical_and_expression
   62                      | logical_or_expression TOK_OR logical_and_expression

   63 conditional_expression: logical_or_expression

   64 assignment_expression: conditional_expression
   65                      | unary_expression TOK_ASSIGN assignment_expression
   66                      | unary_expression TOK_PLUSEQ assignment_expression
   67                      | unary_expression TOK_MINUSEQ assignment_expression
   68                      | unary_expression TOK_MULTEQ assignment_expression
   69                      | unary_expression TOK_DIVEQ assignment_expression
   70                      | unary_expression TOK_MODEQ assignment_expression

   71 expression: assignment_expression
   72           | expression TOK_COMMA assignment_expression

   73 constant_expression: conditional_expression

   74 declaration: declaration_specifiers TOK_SEMICOLON
   75            | declaration_specifiers init_declarator_list TOK_SEMICOLON

   76 declaration_specifiers: storage_class_specifier declaration_specifiers
   77                       | storage_class_specifier
   78                       | type_specifier declaration_specifiers
   79                       | type_specifier

   80 init_declarator_list: init_declarator
   81                     | init_declarator_list TOK_COMMA init_declarator

   82 init_declarator: declarator TOK_ASSIGN initializer
   83                | declarator

   84 storage_class_specifier: TOK_EXTERN
   85                        | TOK_STATIC

   86 type_specifier: TOK_VOID
   87               | TOK_CHAR
   88               | TOK_SHORT
   89               | TOK_INT
   90               | TOK_FLOAT
   91               | TOK_BOOL
   92               | TOK_BOOLEAN
   93               | TOK_INT8_T
   94               | TOK_INT16_T
   95               | TOK_INT32_T
   96               | TOK_INT64_T
   97               | TOK_SIGNED
   98               | TOK_UNSIGNED
   99               | struct_specifier

  100 struct_specifier: TOK_STRUCT TOK_IDENTIFIER TOK_BEGIN struct_declaration_list TOK_END
  101                 | TOK_STRUCT TOK_IDENTIFIER

  102 struct_declaration_list: struct_declaration
  103                        | struct_declaration_list struct_declaration

  104 struct_declaration: specifier_qualifier_list TOK_SEMICOLON
  105                   | specifier_qualifier_list struct_declarator_list TOK_SEMICOLON

  106 specifier_qualifier_list: type_specifier specifier_qualifier_list
  107                         | type_specifier

  108 struct_declarator_list: struct_declarator
  109                       | struct_declarator_list TOK_COMMA struct_declarator

  110 struct_declarator: TOK_COLON constant_expression
  111                  | declarator TOK_COLON constant_expression
  112                  | declarator

  113 declarator: pointer direct_declarator
  114           | direct_declarator

  115 direct_declarator: TOK_IDENTIFIER
  116                  | TOK_LPAREN declarator TOK_RPAREN
  117                  | direct_declarator TOK_LBRACKET TOK_RBRACKET
  118                  | direct_declarator TOK_LBRACKET assignment_expression TOK_RBRACKET
  119                  | direct_declarator TOK_LPAREN parameter_type_list TOK_RPAREN
  120                  | direct_declarator TOK_LPAREN TOK_RPAREN
  121                  | direct_declarator TOK_LPAREN identifier_list TOK_RPAREN

  122 pointer: TOK_STAR pointer
  123        | TOK_STAR

  124 parameter_type_list: parameter_list

  125 parameter_list: parameter_declaration
  126               | parameter_list TOK_COMMA parameter_declaration

  127 parameter_declaration: declaration_specifiers declarator
  128                      | declaration_specifiers abstract_declarator
  129                      | declaration_specifiers

  130 identifier_list: TOK_IDENTIFIER
  131                | identifier_list TOK_COMMA TOK_IDENTIFIER

  132 type_name: specifier_qualifier_list abstract_declarator
  133          | specifier_qualifier_list

  134 abstract_declarator: pointer direct_abstract_declarator
  135                    | pointer
  136                    | direct_abstract_declarator

  137 direct_abstract_declarator: TOK_LPAREN abstract_declarator TOK_RPAREN
  138                           | TOK_LBRACKET TOK_RBRACKET
  139                           | TOK_LBRACKET assignment_expression TOK_RBRACKET
  140                           | direct_abstract_declarator TOK_LBRACKET TOK_RBRACKET
  141                           | direct_abstract_declarator TOK_LBRACKET assignment_expression TOK_RBRACKET
  142                           | TOK_LPAREN TOK_RPAREN
  143                           | TOK_LPAREN parameter_type_list TOK_RPAREN
  144                           | direct_abstract_declarator TOK_LPAREN TOK_RPAREN
  145                           | direct_abstract_declarator TOK_LPAREN parameter_type_list TOK_RPAREN

  146 initializer: TOK_BEGIN initializer_list TOK_END
  147            | TOK_BEGIN initializer_list TOK_COMMA TOK_END
  148            | assignment_expression

  149 initializer_list: designation initializer
  150                 | initializer
  151                 | initializer_list TOK_COMMA designation initializer
  152                 | initializer_list TOK_COMMA initializer

  153 designation: designator_list TOK_ASSIGN

  154 designator_list: designator
  155                | designator_list designator

  156 designator: TOK_LBRACKET constant_expression TOK_RBRACKET
  157           | TOK_DOT TOK_IDENTIFIER

  158 statement: matched_statement
  159          | unmatched_statement
  160          | error TOK_SEMICOLON

  161 compound_statement: TOK_BEGIN TOK_END
  162                   | TOK_BEGIN block_item_list TOK_END

  163 block_item_list: block_item
  164                | block_item_list block_item

  165 block_item: declaration
  166           | statement

  167 expression_statement: TOK_SEMICOLON
  168                     | expression TOK_SEMICOLON

  169 L_mark: ε

  170 M_mark_stmt: expression_statement

  171 M_mark_expr: expression

  172 if_head: TOK_IF TOK_LPAREN expression TOK_RPAREN

  173 if_else_head: if_head matched_statement TOK_ELSE

  174 M_quad_count: ε

  175 matched_statement: compound_statement
  176                  | expression_statement
  177                  | iteration_statement
  178                  | jump_statement
  179                  | TOK_IDENTIFIER TOK_COLON matched_statement
  180                  | TOK_CASE constant_expression TOK_COLON matched_statement
  181                  | TOK_DEFAULT TOK_COLON matched_statement
  182                  | TOK_SWITCH TOK_LPAREN expression TOK_RPAREN matched_statement
  183                  | if_else_head matched_statement

  184 unmatched_statement: TOK_IDENTIFIER TOK_COLON unmatched_statement
  185                    | TOK_CASE constant_expression TOK_COLON unmatched_statement
  186                    | TOK_DEFAULT TOK_COLON unmatched_statement
  187                    | unmatched_iteration_statement
  188                    | if_head statement
  189                    | if_else_head unmatched_statement

  190 iteration_statement: TOK_WHILE L_mark TOK_LPAREN M_mark_expr TOK_RPAREN matched_statement
  191                    | TOK_REPEAT L_mark matched_statement TOK_UNTIL TOK_LPAREN expression TOK_RPAREN TOK_SEMICOLON
  192                    | TOK_FOR TOK_LPAREN expression_statement L_mark M_mark_stmt TOK_RPAREN matched_statement
  193                    | TOK_FOR TOK_LPAREN expression_statement L_mark M_mark_stmt M_quad_count expression M_quad_count TOK_RPAREN matched_statement
  194                    | TOK_FOR TOK_LPAREN declaration L_mark M_mark_stmt TOK_RPAREN matched_statement
  195                    | TOK_FOR TOK_LPAREN declaration L_mark M_mark_stmt M_quad_count expression M_quad_count TOK_RPAREN matched_statement

  196 unmatched_iteration_statement: TOK_WHILE L_mark TOK_LPAREN M_mark_expr TOK_RPAREN unmatched_statement
  197                              | TOK_REPEAT L_mark unmatched_statement TOK_UNTIL TOK_LPAREN expression TOK_RPAREN TOK_SEMICOLON
  198                              | TOK_FOR TOK_LPAREN expression_statement L_mark M_mark_stmt TOK_RPAREN unmatched_statement
  199                              | TOK_FOR TOK_LPAREN expression_statement L_mark M_mark_stmt M_quad_count expression M_quad_count TOK_RPAREN unmatched_statement
  200                              | TOK_FOR TOK_LPAREN declaration L_mark M_mark_stmt TOK_RPAREN unmatched_statement
  201                              | TOK_FOR TOK_LPAREN declaration L_mark M_mark_stmt M_quad_count expression M_quad_count TOK_RPAREN unmatched_statement

  202 jump_statement: TOK_CONTINUE TOK_SEMICOLON
  203               | TOK_BREAK TOK_SEMICOLON
  204               | TOK_RETURN TOK_SEMICOLON
  205               | TOK_RETURN expression TOK_SEMICOLON

  206 translation_unit: external_declaration
  207                 | translation_unit external_declaration

  208 external_declaration: function_definition
  209                     | declaration

  210 function_definition: declaration_specifiers declarator declaration_list compound_statement
  211                    | declaration_specifiers declarator compound_statement

  212 declaration_list: declaration
  213                 | declaration_list declaration


