   17               | TOK_BOOL
   18               | TOK_BOOLEAN
   19               | TOK_SIGNED type_specifier
   20               | TOK_UNSIGNED type_specifier
   21               | TOK_STRUCT TOK_IDENTIFIER

   22 storage_class: TOK_EXTERN
   23              | TOK_STATIC

   24 variable_declaration: type_specifier declarator
   25                     | type_specifier declarator TOK_ASSIGN expression
   26                     | storage_class type_specifier declarator
   27                     | storage_class type_specifier declarator TOK_ASSIGN expression

   28 declarator: TOK_IDENTIFIER
   29           | TOK_STAR declarator
   30           | declarator TOK_LBRACKET TOK_RBRACKET
   31           | declarator TOK_LBRACKET TOK_INTEGER TOK_RBRACKET

   32 function_declaration: type_specifier TOK_IDENTIFIER TOK_LPAREN parameter_list TOK_RPAREN compound_statement
   33                     | type_specifier TOK_IDENTIFIER TOK_LPAREN TOK_RPAREN compound_statement

   34 parameter_list: parameter
   35               | parameter_list TOK_COMMA parameter

   36 parameter: type_specifier declarator

   37 struct_declaration: TOK_STRUCT TOK_IDENTIFIER TOK_LBRACE struct_member_list TOK_RBRACE

   38 struct_member_list: struct_member
   39                   | struct_member_list struct_member

   40 struct_member: type_specifier declarator TOK_SEMICOLON

   41 statement: expression_statement
   42          | compound_statement
   43          | selection_statement
   44          | iteration_statement
   45          | jump_statement
   46          | variable_declaration TOK_SEMICOLON

   47 compound_statement: TOK_LBRACE TOK_RBRACE
   48                   | TOK_LBRACE statement_list TOK_RBRACE
   49                   | TOK_BEGIN statement_list TOK_END

   50 statement_list: statement
   51               | statement_list statement

   52 expression_statement: TOK_SEMICOLON
   53                     | expression TOK_SEMICOLON

   54 selection_statement: TOK_IF TOK_LPAREN expression TOK_RPAREN statement
   55                    | TOK_IF TOK_LPAREN expression TOK_RPAREN statement TOK_ELSE statement
   56                    | TOK_SWITCH TOK_LPAREN expression TOK_RPAREN TOK_LBRACE case_list TOK_RBRACE

   57 case_list: case_item
   58          | case_list case_item

   59 case_item: TOK_CASE expression TOK_COLON statement_list
   60          | TOK_DEFAULT TOK_COLON statement_list

   61 iteration_statement: TOK_WHILE TOK_LPAREN expression TOK_RPAREN statement
   62                    | TOK_FOR TOK_LPAREN expression_opt TOK_SEMICOLON expression_opt TOK_SEMICOLON expression_opt TOK_RPAREN statement
   63                    | TOK_FOR TOK_LPAREN variable_declaration TOK_SEMICOLON expression_opt TOK_SEMICOLON expression_opt TOK_RPAREN statement
   64                    | TOK_REPEAT statement TOK_UNTIL TOK_LPAREN expression TOK_RPAREN TOK_SEMICOLON

   65 expression_opt: /* empty */
   66               | expression

   67 jump_statement: TOK_BREAK TOK_SEMICOLON
   68               | TOK_CONTINUE TOK_SEMICOLON
   69               | TOK_RETURN TOK_SEMICOLON
   70               | TOK_RETURN expression TOK_SEMICOLON

   71 expression: assignment_expression
   72           | expression TOK_COMMA assignment_expression

   73 assignment_expression: logical_or_expression
   74                      | logical_or_expression TOK_ASSIGN assignment_expression
   75                      | logical_or_expression TOK_PLUSEQ assignment_expression
   76                      | logical_or_expression TOK_MINUSEQ assignment_expression
   77                      | logical_or_expression TOK_MULTEQ assignment_expression
   78                      | logical_or_expression TOK_DIVEQ assignment_expression
   79                      | logical_or_expression TOK_MODEQ assignment_expression

   80 logical_or_expression: logical_and_expression
   81                      | logical_or_expression TOK_OR logical_and_expression

   82 logical_and_expression: bitwise_or_expression
   83                       | logical_and_expression TOK_AND bitwise_or_expression

   84 bitwise_or_expression: bitwise_xor_expression
   85                      | bitwise_or_expression TOK_BITOR bitwise_xor_expression

   86 bitwise_xor_expression: bitwise_and_expression
   87                       | bitwise_xor_expression TOK_XOR bitwise_and_expression

   88 bitwise_and_expression: equality_expression
   89                       | bitwise_and_expression TOK_BITAND equality_expression

   90 equality_expression: relational_expression
   91                    | equality_expression TOK_EQ relational_expression
   92                    | equality_expression TOK_NE relational_expression

   93 relational_expression: shift_expression
   94                      | relational_expression TOK_LT shift_expression
   95                      | relational_expression TOK_LE shift_expression
   96                      | relational_expression TOK_GT shift_expression
   97                      | relational_expression TOK_GE shift_expression
   98                      | relational_expression TOK_SPACESHIP shift_expression

   99 shift_expression: additive_expression
