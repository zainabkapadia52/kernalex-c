  101                 | shift_expression TOK_RSHIFT additive_expression

  102 additive_expression: multiplicative_expression
  103                    | additive_expression TOK_PLUS multiplicative_expression
  104                    | additive_expression TOK_MINUS multiplicative_expression

  105 multiplicative_expression: unary_expression
  106                          | multiplicative_expression TOK_MULT unary_expression
  107                          | multiplicative_expression TOK_DIV unary_expression
  108                          | multiplicative_expression TOK_MOD unary_expression

  109 unary_expression: postfix_expression
