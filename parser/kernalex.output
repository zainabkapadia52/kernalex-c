Grammar

    0 $accept: translation_unit $end

    1 primary_expression: TOK_IDENTIFIER
    2                   | constant
    3                   | string
    4                   | TOK_TRUE
    5                   | TOK_FALSE
    6                   | TOK_LPAREN expression TOK_RPAREN

    7 constant: TOK_INTEGER
    8         | TOK_FLOAT_LIT
    9         | TOK_CHAR_LIT

   10 string: TOK_STRING_LIT

   11 postfix_expression: primary_expression
   12                   | postfix_expression TOK_LBRACKET expression TOK_RBRACKET
   13                   | postfix_expression TOK_LPAREN TOK_RPAREN
   14                   | postfix_expression TOK_LPAREN argument_expression_list TOK_RPAREN
   15                   | postfix_expression TOK_DOT TOK_IDENTIFIER
   16                   | postfix_expression TOK_ARROW TOK_IDENTIFIER
   17                   | postfix_expression TOK_INC
   18                   | postfix_expression TOK_DEC
   19                   | TOK_LPAREN type_name TOK_RPAREN TOK_BEGIN initializer_list TOK_END
   20                   | TOK_LPAREN type_name TOK_RPAREN TOK_BEGIN initializer_list TOK_COMMA TOK_END

   21 argument_expression_list: assignment_expression
   22                         | argument_expression_list TOK_COMMA assignment_expression

   23 unary_expression: postfix_expression
   24                 | TOK_INC unary_expression
   25                 | TOK_DEC unary_expression
   26                 | unary_operator cast_expression
   27                 | TOK_SIZEOF unary_expression
   28                 | TOK_SIZEOF TOK_LPAREN type_name TOK_RPAREN

   29 unary_operator: TOK_AMP
   30               | TOK_STAR
   31               | TOK_PLUS
   32               | TOK_MINUS
   33               | TOK_BITNOT
   34               | TOK_NOT

   35 cast_expression: unary_expression
   36                | TOK_LPAREN type_name TOK_RPAREN cast_expression

   37 multiplicative_expression: cast_expression
   38                          | multiplicative_expression TOK_MULT cast_expression
   39                          | multiplicative_expression TOK_DIV cast_expression
   40                          | multiplicative_expression TOK_MOD cast_expression

   41 additive_expression: multiplicative_expression
   42                    | additive_expression TOK_PLUS multiplicative_expression
   43                    | additive_expression TOK_MINUS multiplicative_expression

   44 shift_expression: additive_expression
   45                 | shift_expression TOK_LSHIFT additive_expression
   46                 | shift_expression TOK_RSHIFT additive_expression

   47 relational_expression: shift_expression
   48                      | relational_expression TOK_LT shift_expression
   49                      | relational_expression TOK_GT shift_expression
   50                      | relational_expression TOK_LE shift_expression
   51                      | relational_expression TOK_GE shift_expression
   52                      | relational_expression TOK_SPACESHIP shift_expression

   53 equality_expression: relational_expression
   54                    | equality_expression TOK_EQ relational_expression
   55                    | equality_expression TOK_NE relational_expression

   56 and_expression: equality_expression
   57               | and_expression TOK_AMP equality_expression

   58 exclusive_or_expression: and_expression
   59                        | exclusive_or_expression TOK_XOR and_expression

   60 inclusive_or_expression: exclusive_or_expression
   61                        | inclusive_or_expression TOK_BITOR exclusive_or_expression

   62 logical_and_expression: inclusive_or_expression
   63                       | logical_and_expression TOK_AND inclusive_or_expression

   64 logical_or_expression: logical_and_expression
   65                      | logical_or_expression TOK_OR logical_and_expression

   66 conditional_expression: logical_or_expression

   67 assignment_expression: conditional_expression
   68                      | unary_expression assignment_operator assignment_expression

   69 assignment_operator: TOK_ASSIGN
   70                    | TOK_MULTEQ
   71                    | TOK_DIVEQ
   72                    | TOK_MODEQ
   73                    | TOK_PLUSEQ
   74                    | TOK_MINUSEQ

   75 expression: assignment_expression
   76           | expression TOK_COMMA assignment_expression

   77 constant_expression: conditional_expression

   78 declaration: declaration_specifiers TOK_SEMICOLON
   79            | declaration_specifiers init_declarator_list TOK_SEMICOLON

   80 declaration_specifiers: storage_class_specifier declaration_specifiers
   81                       | storage_class_specifier
   82                       | type_specifier declaration_specifiers
   83                       | type_specifier

   84 init_declarator_list: init_declarator
   85                     | init_declarator_list TOK_COMMA init_declarator

   86 init_declarator: declarator TOK_ASSIGN initializer
   87                | declarator

   88 storage_class_specifier: TOK_EXTERN
   89                        | TOK_STATIC

   90 type_specifier: TOK_VOID
   91               | TOK_CHAR
   92               | TOK_SHORT
   93               | TOK_INT
   94               | TOK_FLOAT
   95               | TOK_BOOL
   96               | TOK_BOOLEAN
   97               | TOK_INT8_T
   98               | TOK_INT16_T
   99               | TOK_INT32_T
  100               | TOK_INT64_T
  101               | TOK_SIGNED
  102               | TOK_UNSIGNED
  103               | struct_specifier

  104 struct_specifier: TOK_STRUCT TOK_IDENTIFIER TOK_BEGIN struct_declaration_list TOK_END
  105                 | TOK_STRUCT TOK_IDENTIFIER

  106 struct_declaration_list: struct_declaration
  107                        | struct_declaration_list struct_declaration

  108 struct_declaration: specifier_qualifier_list TOK_SEMICOLON
  109                   | specifier_qualifier_list struct_declarator_list TOK_SEMICOLON

  110 specifier_qualifier_list: type_specifier specifier_qualifier_list
  111                         | type_specifier

  112 struct_declarator_list: struct_declarator
  113                       | struct_declarator_list TOK_COMMA struct_declarator

  114 struct_declarator: TOK_COLON constant_expression
  115                  | declarator TOK_COLON constant_expression
  116                  | declarator

  117 declarator: pointer direct_declarator
  118           | direct_declarator

  119 direct_declarator: TOK_IDENTIFIER
  120                  | TOK_LPAREN declarator TOK_RPAREN
  121                  | direct_declarator TOK_LBRACKET TOK_RBRACKET
  122                  | direct_declarator TOK_LBRACKET assignment_expression TOK_RBRACKET
  123                  | direct_declarator TOK_LPAREN parameter_type_list TOK_RPAREN
  124                  | direct_declarator TOK_LPAREN TOK_RPAREN
  125                  | direct_declarator TOK_LPAREN identifier_list TOK_RPAREN

  126 pointer: TOK_STAR pointer
  127        | TOK_STAR

  128 parameter_type_list: parameter_list

  129 parameter_list: parameter_declaration
  130               | parameter_list TOK_COMMA parameter_declaration

  131 parameter_declaration: declaration_specifiers declarator
  132                      | declaration_specifiers abstract_declarator
  133                      | declaration_specifiers

  134 identifier_list: TOK_IDENTIFIER
  135                | identifier_list TOK_COMMA TOK_IDENTIFIER

  136 type_name: specifier_qualifier_list abstract_declarator
  137          | specifier_qualifier_list

  138 abstract_declarator: pointer direct_abstract_declarator
  139                    | pointer
  140                    | direct_abstract_declarator

  141 direct_abstract_declarator: TOK_LPAREN abstract_declarator TOK_RPAREN
  142                           | TOK_LBRACKET TOK_RBRACKET
  143                           | TOK_LBRACKET assignment_expression TOK_RBRACKET
  144                           | direct_abstract_declarator TOK_LBRACKET TOK_RBRACKET
  145                           | direct_abstract_declarator TOK_LBRACKET assignment_expression TOK_RBRACKET
  146                           | TOK_LPAREN TOK_RPAREN
  147                           | TOK_LPAREN parameter_type_list TOK_RPAREN
  148                           | direct_abstract_declarator TOK_LPAREN TOK_RPAREN
  149                           | direct_abstract_declarator TOK_LPAREN parameter_type_list TOK_RPAREN

  150 initializer: TOK_BEGIN initializer_list TOK_END
  151            | TOK_BEGIN initializer_list TOK_COMMA TOK_END
  152            | assignment_expression

  153 initializer_list: designation initializer
  154                 | initializer
  155                 | initializer_list TOK_COMMA designation initializer
  156                 | initializer_list TOK_COMMA initializer

  157 designation: designator_list TOK_ASSIGN

  158 designator_list: designator
  159                | designator_list designator

  160 designator: TOK_LBRACKET constant_expression TOK_RBRACKET
  161           | TOK_DOT TOK_IDENTIFIER

  162 statement: matched_statement
  163          | unmatched_statement

  164 compound_statement: TOK_BEGIN TOK_END
  165                   | TOK_BEGIN block_item_list TOK_END

  166 block_item_list: block_item
  167                | block_item_list block_item

  168 block_item: declaration
  169           | statement

  170 expression_statement: TOK_SEMICOLON
  171                     | expression TOK_SEMICOLON

  172 matched_statement: compound_statement
  173                  | expression_statement
  174                  | iteration_statement
  175                  | jump_statement
  176                  | TOK_IDENTIFIER TOK_COLON matched_statement
  177                  | TOK_CASE constant_expression TOK_COLON matched_statement
  178                  | TOK_DEFAULT TOK_COLON matched_statement
  179                  | TOK_SWITCH TOK_LPAREN expression TOK_RPAREN matched_statement
  180                  | TOK_IF TOK_LPAREN expression TOK_RPAREN matched_statement TOK_ELSE matched_statement

  181 unmatched_statement: TOK_IDENTIFIER TOK_COLON unmatched_statement
  182                    | TOK_CASE constant_expression TOK_COLON unmatched_statement
  183                    | TOK_DEFAULT TOK_COLON unmatched_statement
  184                    | unmatched_iteration_statement
  185                    | TOK_IF TOK_LPAREN expression TOK_RPAREN statement
  186                    | TOK_IF TOK_LPAREN expression TOK_RPAREN matched_statement TOK_ELSE unmatched_statement

  187 iteration_statement: TOK_WHILE TOK_LPAREN expression TOK_RPAREN matched_statement
  188                    | TOK_REPEAT matched_statement TOK_UNTIL TOK_LPAREN expression TOK_RPAREN TOK_SEMICOLON
  189                    | TOK_FOR TOK_LPAREN expression_statement expression_statement TOK_RPAREN matched_statement
  190                    | TOK_FOR TOK_LPAREN expression_statement expression_statement expression TOK_RPAREN matched_statement
  191                    | TOK_FOR TOK_LPAREN declaration expression_statement TOK_RPAREN matched_statement
  192                    | TOK_FOR TOK_LPAREN declaration expression_statement expression TOK_RPAREN matched_statement

  193 unmatched_iteration_statement: TOK_WHILE TOK_LPAREN expression TOK_RPAREN unmatched_statement
  194                              | TOK_REPEAT unmatched_statement TOK_UNTIL TOK_LPAREN expression TOK_RPAREN TOK_SEMICOLON
  195                              | TOK_FOR TOK_LPAREN expression_statement expression_statement TOK_RPAREN unmatched_statement
  196                              | TOK_FOR TOK_LPAREN expression_statement expression_statement expression TOK_RPAREN unmatched_statement
  197                              | TOK_FOR TOK_LPAREN declaration expression_statement TOK_RPAREN unmatched_statement
  198                              | TOK_FOR TOK_LPAREN declaration expression_statement expression TOK_RPAREN unmatched_statement

  199 jump_statement: TOK_CONTINUE TOK_SEMICOLON
  200               | TOK_BREAK TOK_SEMICOLON
  201               | TOK_RETURN TOK_SEMICOLON
  202               | TOK_RETURN expression TOK_SEMICOLON

  203 translation_unit: external_declaration
  204                 | translation_unit external_declaration

  205 external_declaration: function_definition
  206                     | declaration

  207 function_definition: declaration_specifiers declarator declaration_list compound_statement
  208                    | declaration_specifiers declarator compound_statement

  209 declaration_list: declaration
  210                 | declaration_list declaration


